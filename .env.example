# Copy to .env (never commit .env). On HuggingFace Spaces use "Secrets".
# Required by Nominatim/Overpass/Wikipedia fair-use policies: identify yourself
CONTACT_EMAIL=your.name@example.com
# Optional: Climatiq (free tier). Without it the local emission-factor table is used.
CLIMATIQ_API_KEY=
CLIMATIQ_DATA_VERSION=^6
# Verify these in the Climatiq data explorer; modes without an ID use the local table
CLIMATIQ_TRAIN_ID=
CLIMATIQ_COACH_ID=
CLIMATIQ_FLIGHT_ID=
# Optional: escalation webhook (CRM/helpdesk). Otherwise written to handover_queue.jsonl
HANDOVER_WEBHOOK_URL=
